{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generative CNF run summary v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "task",
    "method",
    "status",
    "git_revision",
    "dirty",
    "config_path",
    "config_sha256",
    "dataset",
    "seeds",
    "attempts",
    "failures",
    "metrics",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "enum": [
        "shape_completion",
        "action_generation",
        "video_generation",
        "deformation",
        "fluid_generation",
        "pde_generation"
      ]
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "incomplete",
        "succeeded",
        "failed"
      ]
    },
    "git_revision": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "dirty": {
      "type": "boolean"
    },
    "config_path": {
      "type": "string",
      "minLength": 1
    },
    "config_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "dataset": {
      "type": "object",
      "required": [
        "id",
        "revision",
        "split"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "revision": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "split": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "seeds": {
      "type": "object",
      "required": [
        "training",
        "sampling"
      ],
      "additionalProperties": false,
      "properties": {
        "training": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "sampling": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "attempts": {
      "type": "integer",
      "minimum": 0
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value",
          "unit",
          "stage",
          "scope",
          "count"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "enum": [
              "raw",
              "constrained",
              "postprocess",
              "rendered",
              "executed"
            ]
          },
          "scope": {
            "enum": [
              "finite_constraints",
              "continuous_domain",
              "intermediate_field",
              "final_output"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "statistic": {
            "enum": [
              "mean",
              "max",
              "median",
              "rate",
              "single"
            ]
          },
          "tolerance": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "uri",
          "sha256",
          "role"
        ],
        "additionalProperties": false,
        "properties": {
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "succeeded"
          }
        }
      },
      "then": {
        "properties": {
          "metrics": {
            "minItems": 1
          },
          "git_revision": {
            "type": "string"
          },
          "config_sha256": {
            "type": "string"
          },
          "attempts": {
            "minimum": 1
          },
          "dataset": {
            "properties": {
              "id": {
                "type": "string"
              },
              "revision": {
                "type": "string"
              },
              "split": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "failures": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
